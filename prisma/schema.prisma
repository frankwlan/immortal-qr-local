generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon's PgBouncer endpoint, hostname ends in
  // "-pooler") — used at runtime by the app, since serverless functions
  // can each open their own connection and a direct connection limit is
  // easy to exhaust under real traffic.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection — Prisma's migrate commands need
  // this, not the pooled one, to run schema migrations correctly.
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  resetTokenHash    String?   @unique
  resetTokenExpires DateTime?
  verifyTokenHash    String?   @unique
  verifyTokenExpires DateTime?
  qrLinks           QrLink[]
  accounts          Account[]
  sessions          Session[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model QrLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  destination String
  slug        String   @unique
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scans       ScanEvent[]

  @@index([userId, deletedAt])
}

model ScanEvent {
  id         String   @id @default(cuid())
  qrLinkId   String
  qrLink     QrLink   @relation(fields: [qrLinkId], references: [id])
  scannedAt  DateTime @default(now())
  // Hashed, not raw — people scanning a QR code aren't app users and
  // haven't agreed to anything, so we avoid storing their IP in plain
  // text. This isn't true anonymization (IPv4 space is small enough to
  // be reversible by brute force), just a basic privacy floor; don't
  // treat it as a guarantee.
  ipHash     String?
  userAgent  String?

  @@index([qrLinkId, scannedAt])
}

// --- NextAuth models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}