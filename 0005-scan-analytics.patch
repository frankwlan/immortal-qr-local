@@ -0,0 +1,16 @@
+-- CreateTable
+CREATE TABLE "ScanEvent" (
+    "id" TEXT NOT NULL,
+    "qrLinkId" TEXT NOT NULL,
+    "scannedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "ipHash" TEXT,
+    "userAgent" TEXT,
+
+    CONSTRAINT "ScanEvent_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE INDEX "ScanEvent_qrLinkId_scannedAt_idx" ON "ScanEvent"("qrLinkId", "scannedAt");
+
+-- AddForeignKey
+ALTER TABLE "ScanEvent" ADD CONSTRAINT "ScanEvent_qrLinkId_fkey" FOREIGN KEY ("qrLinkId") REFERENCES "QrLink"("id") ON DELETE RESTRICT ON UPDATE CASCADE;
diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index 3785c05..f56b38f 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -32,10 +32,27 @@ model QrLink {
   deletedAt   DateTime?
   createdAt   DateTime @default(now())
   updatedAt   DateTime @updatedAt
+  scans       ScanEvent[]
 
   @@index([userId, deletedAt])
 }
 
+model ScanEvent {
+  id         String   @id @default(cuid())
+  qrLinkId   String
+  qrLink     QrLink   @relation(fields: [qrLinkId], references: [id])
+  scannedAt  DateTime @default(now())
+  // Hashed, not raw — people scanning a QR code aren't app users and
+  // haven't agreed to anything, so we avoid storing their IP in plain
+  // text. This isn't true anonymization (IPv4 space is small enough to
+  // be reversible by brute force), just a basic privacy floor; don't
+  // treat it as a guarantee.
+  ipHash     String?
+  userAgent  String?
+
+  @@index([qrLinkId, scannedAt])
+}
+
 // --- NextAuth models ---
 model Account {
   id                String  @id @default(cuid())
