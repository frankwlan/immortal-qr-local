 next.config.js                        |   16 +-
 package-lock.json                     | 1522 +++++++++++++++++++++++--
 package.json                          |    3 +
 sentry.client.config.js               |   10 +
 sentry.server.config.js               |   14 +
 src/lib/rateLimit.js                  |   66 +-
 src/lib/scanTracking.js               |    4 +
 src/pages/_error.js                   |   15 +
 src/pages/api/auth/forgot-password.js |   14 +-
 src/pages/api/auth/register.js        |   12 +-
 src/pages/api/qr/create.js            |   12 +-
 src/pages/api/qr/redirect/[slug].js   |    2 +
 13 files changed, 1567 insertions(+), 142 deletions(-)
 create mode 100644 sentry.client.config.js
 create mode 100644 sentry.server.config.js
 create mode 100644 src/pages/_error.js

diff --git a/.env.example b/.env.example
index 843eb12..d82ead1 100644
--- a/.env.example
+++ b/.env.example
@@ -18,6 +18,25 @@ DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/immortalqr?schema=public&sslmode
 RESEND_API_KEY=
 EMAIL_FROM=onboarding@resend.dev
 
+# RATE LIMITING (optional locally, recommended in production)
+# Without these, rate limits fall back to an in-memory counter that only
+# works within a single server process — on Vercel that means each
+# serverless instance counts separately, so limits are easy to bypass.
+# Create a free Redis database at https://upstash.com and copy the REST
+# URL and token from its dashboard.
+UPSTASH_REDIS_REST_URL=
+UPSTASH_REDIS_REST_TOKEN=
+
+# ERROR MONITORING (optional locally, recommended in production)
+# Create a Next.js project at https://sentry.io and copy its DSN. A DSN is
+# not a secret — one value covers browser and server code.
+NEXT_PUBLIC_SENTRY_DSN=
+# Only needed for readable (un-minified) stack traces in Sentry. Without
+# them, errors still arrive — just with minified stack traces.
+SENTRY_ORG=
+SENTRY_PROJECT=
+SENTRY_AUTH_TOKEN=
+
 # NextAuth OAuth is not wired up yet (see src/lib/authOptions.js). Leave unset for now.
 # GOOGLE_CLIENT_ID=
 # GOOGLE_CLIENT_SECRET=
diff --git a/next.config.js b/next.config.js
index a3cffcf..8dec385 100644
--- a/next.config.js
+++ b/next.config.js
@@ -1,3 +1,5 @@
+const { withSentryConfig } = require("@sentry/nextjs/config");
+
 /** @type {import('next').NextConfig} */
 const nextConfig = {
   reactStrictMode: true,
@@ -11,4 +13,16 @@ const nextConfig = {
   },
 };
 
-module.exports = nextConfig;
+// Wraps the build so API routes are auto-instrumented and errors reach
+// Sentry. This works even with none of the SENTRY_* env vars set (verified
+// directly — the build just skips source-map upload, which is the only
+// part that needs org/project/authToken). Source maps for readable stack
+// traces need SENTRY_ORG, SENTRY_PROJECT, and SENTRY_AUTH_TOKEN; without
+// them, errors still reach Sentry, just with minified stack traces.
+module.exports = withSentryConfig(nextConfig, {
+  org: process.env.SENTRY_ORG,
+  project: process.env.SENTRY_PROJECT,
+  authToken: process.env.SENTRY_AUTH_TOKEN,
+  silent: true,
+  widenClientFileUpload: true,
+});
