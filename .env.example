# NEXTAUTH
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_strong_random_string

# DATABASE
# In Neon's dashboard, turn on "Connection pooling" under Connect, then
# copy both strings it gives you:
#   DATABASE_URL -> the pooled string (hostname has a "-pooler" suffix) —
#                    used by the app at runtime
#   DIRECT_URL   -> the direct (non-pooled) string — used only when
#                    running `prisma migrate deploy`
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:PORT/immortalqr?schema=public&sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/immortalqr?schema=public&sslmode=require

# EMAIL (used for password reset links)
# Sign up at https://resend.com, verify a sending domain (or use their
# sandbox sender onboarding@resend.dev for testing), and create an API key.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# RATE LIMITING (optional locally, recommended in production)
# Without these, rate limits fall back to an in-memory counter that only
# works within a single server process — on Vercel that means each
# serverless instance counts separately, so limits are easy to bypass.
# Create a free Redis database at https://upstash.com and copy the REST
# URL and token from its dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ERROR MONITORING (optional locally, recommended in production)
# Create a Next.js project at https://sentry.io and copy its DSN. A DSN is
# not a secret — one value covers browser and server code.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for readable (un-minified) stack traces in Sentry. Without
# them, errors still arrive — just with minified stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# NextAuth OAuth is not wired up yet (see src/lib/authOptions.js). Leave unset for now.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
